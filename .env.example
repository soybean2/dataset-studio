# 复制为 .env 后按需修改（docker compose 会自动读取）

# ---------- 主服务 ----------
HOST=0.0.0.0
PORT=8787
# 数据目录：SQLite 库、原图、缩略图、导出结果都放这里
DATA_DIR=./data
MAX_UPLOAD_MB=40

# 「从目录导入」和自定义导出目录允许访问的服务器路径前缀。
# 留空 = 不限制（仅建议在完全可信的内网使用）
IMPORT_ROOT=

# 打标服务地址（裸机运行时改成 http://127.0.0.1:8790）
TAGGER_URL=http://127.0.0.1:8790

# ---------- Docker Compose ----------
# 宿主机上存放待导入图片的目录，会挂载到容器 /data/imports
IMPORT_HOST_DIR=./imports

# ---------- 打标 sidecar ----------
# auto = 能加载 torch 就用 WD Tagger，否则退回 stub（假数据，仅联调用）
TAGGER_MODE=auto
# auto = 有 CUDA 用 GPU，否则 CPU
TAGGER_DEVICE=auto
TAGGER_THRESHOLD=0.35
TAGGER_MAX_TAGS=30
# 1 = 启动时就加载模型权重（首次会从 HuggingFace 下载）
TAGGER_EAGER=0
# CPU 版 torch 源；要用 GPU 改成 https://download.pytorch.org/whl/cu121
TORCH_INDEX=https://download.pytorch.org/whl/cpu
